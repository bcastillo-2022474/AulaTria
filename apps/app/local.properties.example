## Copy to apps/app/local.properties (gitignored) and adjust.
# Android SDK location (Android Studio writes this for you; needed to build the Android app on the command line)
sdk.dir=/home/YOU/Android/Sdk
# The API the ANDROID app talks to.
#   emulator (default, can be omitted):  http://10.0.2.2:3000
#   real phone on the same Wi-Fi:        http://<your computer's LAN IP>:3000   (find it with: hostname -I)
apiBaseUrl=http://10.0.2.2:3000
