# The gateway: the ONLY public service. Railway terminates TLS at its edge and forwards plain HTTP to $PORT,
# so Caddy listens on HTTP and does not manage certificates. Two hostnames, one container:
#   TEACHER_HOST  (aulatria.sudoersgt.dev)             -> the teacher web app (static, SPA)
#   STUDENT_HOST  (estudiantes.aulatria.sudoersgt.dev) -> the student app's browser build (static, SPA)
# Both call /api/* on their own host, proxied to the API over Railway's private network (no CORS involved).
{
	auto_https off
	admin off
}

:{$PORT:8080} {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Connect RPC, including the long-lived WatchLesson stream: flush every chunk, never buffer.
	# handle_path strips /api so the API keeps its root-level paths (/aula.lessons.v1.LessonsService/...).
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM} {
			flush_interval -1
			transport http {
				response_header_timeout 0
				read_timeout 0
			}
		}
	}

	@student host {$STUDENT_HOST}
	handle @student {
		root * /srv/student
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/teacher
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
