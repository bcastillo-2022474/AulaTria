<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>ApiBaseUrl</key>
	<string>$(API_BASE_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Lets a dev build call http://<lan-ip>:3000. Applies only to local-network
		     addresses; every public host still has to be HTTPS. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AulaTria se conecta al servidor de desarrollo en tu red local.</string>
	<!-- Attendance: the student's position is compared with the classroom's, on the server. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Usamos tu ubicación solo para confirmar que estás en el aula.</string>
	<key>NSCameraUsageDescription</key>
	<string>Usamos la cámara para escanear el código QR de asistencia.</string>
</dict>
</plist>
